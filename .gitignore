logs/data_*/
logs/data_*.jsonl

# Evaluation and experiment runs: re-created by survey_tracks.py / drive.py
logs/*.jsonl
logs/*/

# Pre-processed dataset caches, rebuilt by dataset.py
logs/*.npz

# Small, kept on purpose: logs/*.txt (training/survey outputs quoted in the docs),
